{
  "version": "1.0.0-design-proposal",
  "scope": "Only LightBearing, FrameMori, VoxCarve, MacroLoom; StoroPix excluded",
  "units": "vp for layout, sp/fp follow system text scaling; SVG uses viewBox",
  "color": {
    "dark": {
      "background": "#0B1622",
      "surface": "#152836",
      "surfaceRaised": "#1C3546",
      "border": "#3D5360",
      "text": "#F9FAF3",
      "muted": "#93A9B6",
      "danger": "#F27573",
      "success": "#76D1A2",
      "focus": "#B6DEFF"
    },
    "light": {
      "background": "#F4F1EA",
      "surface": "#FFFFFF",
      "surfaceRaised": "#E7EDEB",
      "border": "#CCD8D6",
      "text": "#141F2A",
      "muted": "#52636D",
      "danger": "#B83C39",
      "success": "#167C4F",
      "focus": "#235A87"
    },
    "appAccents": {
      "lightbearing": {
        "primary": "#FFBC6B",
        "secondary": "#73D9D5"
      },
      "framemori": {
        "primary": "#FF9471",
        "secondary": "#75DDC4"
      },
      "voxcarve": {
        "primary": "#AF9DFF",
        "secondary": "#FDBF92"
      },
      "macroloom": {
        "primary": "#B3F07C",
        "secondary": "#7FC8FF"
      }
    }
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48
  ],
  "radius": {
    "xs": 6,
    "sm": 10,
    "md": 14,
    "lg": 18,
    "xl": 24,
    "hero": 28,
    "pill": 999
  },
  "typography": {
    "display": 34,
    "h1": 28,
    "h2": 22,
    "section": 18,
    "body": 16,
    "secondary": 14,
    "caption": 12,
    "numeric": 34,
    "minTap": 48
  },
  "elevation": {
    "none": 0,
    "card": "0 8px 24px rgba(0,0,0,.12)",
    "overlay": "0 14px 40px rgba(0,0,0,.28)"
  },
  "animation": {
    "quickMs": 120,
    "normalMs": 200,
    "slowMs": 260,
    "reducedMs": 0
  },
  "layout": {
    "compact": "320-599vp",
    "medium": "600-899vp",
    "expanded": "900vp+",
    "contentMax": 1180,
    "sidePadding": 16
  },
  "states": [
    "default",
    "pressed",
    "selected",
    "disabled",
    "loading",
    "empty",
    "error",
    "permission-denied",
    "unsupported",
    "success"
  ],
  "accessibility": {
    "minTap": 48,
    "keyboardFocus": true,
    "dontUseColorAlone": true,
    "reduceMotion": true
  },
  "reusableComponents": [
    "XzPageShell",
    "XzTopBar",
    "XzBottomNav",
    "XzPrimaryButton",
    "XzSecondaryButton",
    "XzIconButton",
    "XzSegmented",
    "XzCard",
    "XzMetricTile",
    "XzStatusTag",
    "XzListCell",
    "XzTextField",
    "XzSlider",
    "XzSwitch",
    "XzDialog",
    "XzToast",
    "XzEmptyState",
    "XzErrorState",
    "XzPermissionGate",
    "XzProgressSheet"
  ]
}
